# Copy to .env and fill in. NEVER commit .env.

# --- LLM (free tiers; at least one key needed) ---
LLM_PROVIDER=gemini                  # gemini | groq  (the other one, if keyed, is the automatic fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash        # check current free-tier model names at ai.google.dev
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile   # check console.groq.com/docs/models

# --- Qdrant ---
# Leave empty to use embedded Qdrant on disk (data/qdrant) — no Docker needed.
QDRANT_URL=                          # e.g. http://localhost:6333 or your Qdrant Cloud URL
QDRANT_API_KEY=
COLLECTION_NAME=documind_chunks

# --- Retrieval / ingestion ---
RETRIEVAL_MODE=hybrid_rerank         # dense | hybrid | hybrid_rerank
CHUNKING_STRATEGY=recursive          # recursive | fixed
CHUNK_SIZE=800
CHUNK_OVERLAP=100
DEVICE=                              # cuda | cpu | empty = auto

# --- Security ---
API_KEY=                             # optional: if set, clients must send X-API-Key
MAX_UPLOAD_MB=20
RATE_LIMIT_PER_MINUTE=30

# --- Tracing (LangSmith, optional) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=documind
